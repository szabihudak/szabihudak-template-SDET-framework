FROM oven/bun:1.4.2

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY --from=upex package.json bun.lock ./

RUN bun install --frozen-lockfile

COPY --from=upex . .

RUN bun run build

EXPOSE 3000

CMD ["bun", "run", "start", "--hostname", "0.0.0.0"]