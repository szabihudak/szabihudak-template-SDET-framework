      "  options: Create${1:Domain}Options = {},",
      "): Complete${1:Domain}Request {",
      "  const id = `\\${Date.now()}-\\${Math.random().toString(36).slice(2, 8)}`;",
      "",
      "  return {",
      "    title: options.title ?? `${2:domain}Title_\\${id}`,",
      "    description: options.description ?? `${2:domain}Description_\\${id}`,",
      "    priority: options.priority ?? \"low\",",
      "    status: options.status ?? \"done\",",
      "  };",
      "}",
