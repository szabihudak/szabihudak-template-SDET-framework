      "  await page.route(${5:DOMAIN}S_API_PATTERN, async (route) => {",
      "    if (route.request().method() !== \"GET\") {",
      "      await route.continue();",
      "      return;",
      "    }",
      "",
      "    await route.fulfill({",
      "      status: 500,",
      "      contentType: \"application/json\",",
      "      body: JSON.stringify({",
      "        error: \"Internal Server Error\",",
      "      }),",
      "    });",
