  "QA k6-workload": {
    "prefix": "qa-k6-workload",
    "description": "API workload performance with setup outside the measured operation and native thresholds",
    "scope": "javascript",
    "body": [
      "import http from \"k6/http\";",
      "import { check, sleep } from \"k6\";",
      "import { Rate, Trend } from \"k6/metrics\";",
      "",
      "export { handleSummary } from \"../../../framework/core/performance/k6/k6SummaryReporter.js\";",
      "",
      "export const options = {",
      "  scenarios: {",
      "    ${2:domain}_read_baseline: {",
      "      executor: \"constant-vus\",",
      "      vus: 2,",
      "      duration: \"30s\",",
      "    },",
      "  },",
      "  thresholds: {",
      "    ${2:domain}_read_duration: [\"p(95)<500\"],",
      "    ${2:domain}_read_failures: [\"rate<0.01\"],",
      "  },",
      "};",
      "",
      "const baseUrl = __ENV.TARGET_BASE_URL;",
      "const ${2:domain}ReadDuration = new Trend(\"${2:domain}_read_duration\", true);",
      "const ${2:domain}ReadFailures = new Rate(\"${2:domain}_read_failures\");",
      "",
      "function createPerformanceUser() {",
      "  const uniqueId = `\\${Date.now()}-\\${Math.random().toString(36).slice(2, 8)}`;",
      "",
      "  return {",
      "    name: `Performance User \\${uniqueId}`,",
      "    email: `perf_\\${uniqueId}@example.com`,",
      "    password: \"TestPassword123!\",",
      "  };",
      "}",
      "",
      "export function setup() {",
      "  if (!baseUrl) {",
      "    throw new Error(\"TARGET_BASE_URL is required\");",
      "  }",
      "",
      "  const user = createPerformanceUser();",
      "",
      "  const registrationResponse = http.post(",
      "    `\\${baseUrl}/auth/register`,",
      "    JSON.stringify(user),",
      "    {",
      "      headers: {",
      "        \"Content-Type\": \"application/json\",",
      "      },",
      "      tags: {",
      "        name: \"setup_register\",",
      "      },",
      "    },",
      "  );",
      "",
      "  const registrationSucceeded = check(registrationResponse, {",
      "    \"performance user registration succeeds\": (response) =>",
      "      response.status >= 200 && response.status < 300,",
      "  });",
      "",
      "  if (!registrationSucceeded) {",
      "    throw new Error(",
      "      `Performance user registration failed with status \\${registrationResponse.status}`,",
      "    );",
      "  }",
      "",
      "  const loginResponse = http.post(",
      "    `\\${baseUrl}/auth/login`,",
      "    JSON.stringify({",
      "      email: user.email,",
      "      password: user.password,",
      "    }),",
      "    {",
      "      headers: {",
      "        \"Content-Type\": \"application/json\",",
      "      },",
      "      tags: {",
      "        name: \"setup_login\",",
      "      },",
      "    },",
      "  );",
      "",
      "  const loginSucceeded = check(loginResponse, {",
      "    \"performance user login succeeds\": (response) =>",
      "      response.status >= 200 && response.status < 300,",
      "  });",
      "",
      "  if (!loginSucceeded) {",
      "    throw new Error(",
      "      `Performance user login failed with status \\${loginResponse.status}`,",
      "    );",
      "  }",
      "",
      "  const loginBody = loginResponse.json();",
      "",
      "  if (!loginBody.access_token) {",
      "    throw new Error(\"Login response did not contain access_token\");",
      "  }",
      "",
      "  const ${2:domain}Response = http.post(",
      "    `\\${baseUrl}/${4:domains}`,",
      "    JSON.stringify({",
      "      title: `Performance ${1:Domain} \\${Date.now()}`,",
      "    }),",
      "    {",
      "      headers: {",
      "        \"Content-Type\": \"application/json\",",
      "        Authorization: `Bearer \\${loginBody.access_token}`,",
      "      },",
      "      tags: {",
      "        name: \"setup_create_${2:domain}\",",
      "      },",
      "    },",
      "  );",
      "",
      "  const ${2:domain}Created = check(${2:domain}Response, {",
      "    \"performance ${2:domain} creation succeeds\": (response) =>",
      "      response.status >= 200 && response.status < 300,",
      "  });",
      "",
      "  if (!${2:domain}Created) {",
      "    throw new Error(",
      "      `Performance ${2:domain} creation failed with status \\${${2:domain}Response.status}`,",
      "    );",
      "  }",
      "",
      "  const ${2:domain}Body = ${2:domain}Response.json();",
      "",
      "  if (!${2:domain}Body.id) {",
      "    throw new Error(\"${1:Domain} creation response did not contain id\");",
      "  }",
      "",
      "  return {",
      "    accessToken: loginBody.access_token,",
      "    ${2:domain}Id: ${2:domain}Body.id,",
      "  };",
      "}",
      "",
      "export default function (data) {",
      "  const response = http.get(`\\${baseUrl}/${4:domains}`, {",
      "    headers: {",
      "      Authorization: `Bearer \\${data.accessToken}`,",
      "    },",
      "    tags: {",
      "      name: \"${2:domain}_read\",",
      "    },",
      "  });",
      "",
      "  ${2:domain}ReadDuration.add(response.timings.duration);",
      "",
      "  const ${2:domain}ReadSucceeded = check(response, {",
      "    \"${2:domain} read succeeds\": (result) => result.status === 200,",
      "  });",
      "",
      "  ${2:domain}ReadFailures.add(!${2:domain}ReadSucceeded);",
      "",
      "  sleep(1);",
      "}",
      "",
      "export function teardown(data) {",
      "  if (!data?.accessToken || !data?.${2:domain}Id) {",
      "    throw new Error(\"Performance teardown did not receive required setup data\");",
      "  }",
      "",
      "  const deleteResponse = http.del(`\\${baseUrl}/${4:domains}/\\${data.${2:domain}Id}`, null, {",
      "    headers: {",
      "      Authorization: `Bearer \\${data.accessToken}`,",
      "    },",
      "    tags: {",
      "      name: \"teardown_delete_${2:domain}\",",
      "    },",
      "  });",
      "",
      "  const ${2:domain}Deleted = check(deleteResponse, {",
      "    \"performance ${2:domain} cleanup succeeds\": (response) =>",
      "      response.status >= 200 && response.status < 300,",
      "  });",
      "",
      "  if (!${2:domain}Deleted) {",
      "    throw new Error(",
      "      `Performance ${2:domain} cleanup failed with status \\${deleteResponse.status}`,",
      "    );",
      "  }",
      "}"
    ]
  }
}
