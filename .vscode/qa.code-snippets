      "  options: Create${1:Domain}PayloadOptions = {},",
      "): Partial<${1:Domain}Request> {",
      "  const ${2:domain}: Partial<${1:Domain}Request> = create${1:Domain}(options);",
      "",
      "  for (const field of options.missingFields ?? []) {",
      "    delete ${2:domain}[field];",
      "  }",
      "",
      "  return ${2:domain};",
      "}"
    ]
  },
