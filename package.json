{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "description": "Production-oriented Playwright + TypeScript test automation framework for API, UI, contract, Docker, and CI testing.",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "db:test:reset": "tsx src/app/database/resetTestDatabase.ts",
    "ai:generate-test-design": "tsx src/framework/ai/cli/generateTestDesign.ts",
    "ai:analyze-failure": "tsx src/framework/ai/cli/analyzeFailure.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "qa:templates:check": "tsx .qa/scripts/templates.ts check",
    "qa:templates:build": "tsx .qa/scripts/templates.ts build",
    "qa:templates:extract": "tsx .qa/scripts/templates.ts extract",
    "prepare": "husky"
  },
  "author": "Szabolcs Hudak",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chrome-launcher": "^1.2.1",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "openai": "^7.23.0",
    "pg": "^8.23.0"
  }
}
