{
  "appName": "selftest-app-tests",
  "requirementsDoc": "docs/acceptance-criteria.md",
  "uiScenariosDoc": "docs/e2e-journeys.md",
  "environments": {
    "selftest": {
      "webBaseUrl": "http://localhost:4510",
      "apiBaseUrl": "http://localhost:4510/api",
      "openApiUrl": "http://localhost:4510/api/openapi.json",
      "allow": {
        "database": false,
        "destructive": false,
        "performance": false,
        "interactiveDiscovery": true
      }
    }
  },
  "modules": {
    "api": true,
    "ui": true,
    "smoke": true,
    "accessibility": true,
    "database": false,
    "visual": false,
    "performance": true
  },
  "browsers": ["chromium"],
  "auth": {
    "api": {
      "strategy": "bearer",
      "loginPath": "/auth/login",
      "usernameField": "email",
      "passwordField": "password",
      "tokenField": "access_token"
    },
    "browser": {
      "strategy": "nextAuth",
      "csrfPath": "/api/auth/csrf",
      "callbackPath": "/api/auth/callback/credentials",
      "landingPath": "/dashboard",
      "usernameField": "email",
      "passwordField": "password"
    }
  },
  "roles": ["user"]
}
