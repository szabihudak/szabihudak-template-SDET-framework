{
  "appName": "selftest-minimal-tests",
  "environments": {
    "selftest": {
      "webBaseUrl": "http://localhost:4510",
      "apiBaseUrl": "http://localhost:4510/api",
      "openApiUrl": "http://localhost:4510/api/openapi.json",
      "allow": {
        "database": false,
        "destructive": false,
        "performance": false,
        "interactiveDiscovery": false
      }
