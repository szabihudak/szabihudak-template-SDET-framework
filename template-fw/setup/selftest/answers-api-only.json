{
  "appName": "selftest-api-only-tests",
  "environments": {
    "selftest": {
      "webBaseUrl": "http://localhost:4510",
      "apiBaseUrl": "http://localhost:4510/api",
      "allow": {
        "database": false,
        "destructive": false,
        "performance": false
      }
    }
  },
  "modules": {
    "api": true,
    "ui": false,
    "smoke": false,
    "accessibility": false,
    "database": false,
    "visual": false,
    "performance": false,
    "ai": false
  },
  "browsers": ["chromium"],
  "auth": {
    "api": {
      "strategy": "bearer",
      "loginPath": "/auth/login",
      "usernameField": "email",
      "passwordField": "password",
      "tokenField": "access_token"
    },
    "browser": {
      "strategy": "none"
    }
  },
  "roles": ["user"],
  "aiTools": "copilot"
}
