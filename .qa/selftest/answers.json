{
  "appName": "selftest-app-tests",
  "environments": {
    "selftest": {
      "webBaseUrl": "http://localhost:4510",
      "apiBaseUrl": "http://localhost:4510/api",
      "allow": { "database": false, "destructive": false, "performance": false }
    }
  },
  "modules": {
    "api": true,
    "ui": true,
    "smoke": true,
    "accessibility": true,
    "database": false,
    "visual": false,
    "performance": false,
    "ai": false
  },
  "browsers": ["chromium"],
  "auth": {
    "api": {
      "strategy": "bearer",
      "loginPath": "/auth/login",
      "usernameField": "email",
      "passwordField": "password",
      "tokenField": "access_token"
    },
    "browser": {
      "strategy": "nextAuth",
      "csrfPath": "/api/auth/csrf",
      "callbackPath": "/api/auth/callback/credentials",
      "landingPath": "/dashboard",
      "usernameField": "email",
      "passwordField": "password"
    }
  },
  "roles": ["user"],
  "removeExamples": true
}
