{
  "$comment": "Golden template catalogue. Read this before adding a schema, client, factory, Page Object, component, mock, database client, spec or k6 workload. Project-specific examples in .qa-project.json take precedence.",
  "tokens": {
    "__Domain__": "Singular domain type name, e.g. Order",
    "__domain__": "Singular domain identifier, e.g. order",
    "__Domains__": "Plural domain type name, e.g. Orders",
    "__domains__": "Plural domain identifier or API resource, e.g. orders",
    "__DOMAIN__": "Upper-case domain constant prefix, e.g. ORDER",
    "__Page__": "Page Object name without the Page suffix, e.g. OrdersOverview",
    "__page__": "Page Object fixture name without the Page suffix, e.g. ordersOverview",
    "__Component__": "Component Object class name, e.g. NavigationBar"
  },
  "templates": [
    {
      "id": "domain-constants",
      "need": "Reusable domain values such as supported statuses, with derived union types",
      "template": ".qa/templates/api/domain-constants.template.ts",
      "canonical": "src/app/api/constants/task.ts",
      "output": "src/app/api/constants/__domain__.ts",
      "rules": "docs/TESTING_STANDARDS.md#constants-standard"
    },
    {
      "id": "request-schema",
      "need": "Provider request contract for creating a resource",
      "template": ".qa/templates/api/request-schema.template.ts",
      "canonical": "src/app/api/schemas/TaskRequestSchema.ts",
      "output": "src/app/api/schemas/__Domain__RequestSchema.ts",
      "rules": "docs/TESTING_STANDARDS.md#schema-standard"
    },
    {
      "id": "update-request-schema",
      "need": "Provider request contract for partially updating a resource",
      "template": ".qa/templates/api/update-request-schema.template.ts",
      "canonical": "src/app/api/schemas/TaskUpdateRequestSchema.ts",
      "output": "src/app/api/schemas/__Domain__UpdateRequestSchema.ts",
      "rules": "docs/TESTING_STANDARDS.md#schema-standard"
    },
    {
      "id": "response-schema",
      "need": "Provider response contract, used for runtime validation",
      "template": ".qa/templates/api/response-schema.template.ts",
      "canonical": "src/app/api/schemas/TaskResponseSchema.ts",
      "output": "src/app/api/schemas/__Domain__ResponseSchema.ts",
      "rules": "docs/TESTING_STANDARDS.md#schema-standard"
    },
    {
      "id": "api-client",
      "need": "HTTP interaction with a domain endpoint: raw request methods plus fail-fast setup helpers",
      "template": ".qa/templates/api/api-client.template.ts",
      "canonical": "src/app/api/clients/TaskApiClient.ts",
      "output": "src/app/api/clients/__Domain__ApiClient.ts",
      "rules": "docs/TESTING_STANDARDS.md#api-client-standard"
    },
    {
      "id": "factory",
      "need": "Test data: complete valid object with overrides, plus partial request payloads",
      "template": ".qa/templates/data/factory.template.ts",
      "canonical": "src/app/data/taskFactory.ts",
      "output": "src/app/data/__domain__Factory.ts",
      "rules": "docs/TESTING_STANDARDS.md#canonical-factory-and-payload-pattern"
    },
    {
      "id": "page-object",
      "need": "Page-level UI structure, actions and locator queries",
      "template": ".qa/templates/ui/page-object.template.ts",
      "canonical": "src/app/pages/TasksDashboardPage.ts",
      "output": "src/app/pages/__Page__Page.ts",
      "rules": "docs/TESTING_STANDARDS.md#page-object-standard"
    },
    {
      "id": "component-object",
      "need": "Reusable UI region that is not a whole page",
      "template": ".qa/templates/ui/component-object.template.ts",
      "canonical": "src/app/components/NavigationBar.ts",
      "output": "src/app/components/__Component__.ts",
      "rules": "docs/TESTING_STANDARDS.md#component-object-standard"
    },
    {
      "id": "network-mock",
      "need": "Controlled network behavior for one scenario, leaving other requests untouched",
      "template": ".qa/templates/ui/network-mock.template.ts",
      "canonical": "src/app/mocks/taskApiMock.ts",
      "output": "src/app/mocks/__domain__ApiMock.ts",
      "rules": "docs/TESTING_STANDARDS.md#mock-standard"
    },
    {
      "id": "database-client",
      "need": "Domain-specific parameterized SQL and persisted record mapping",
      "template": ".qa/templates/database/database-client.template.ts",
      "canonical": "src/app/database/clients/TaskDatabaseClient.ts",
      "output": "src/app/database/clients/__Domain__DatabaseClient.ts",
      "rules": "docs/TESTING_STANDARDS.md#database-test-standard"
    },
    {
      "id": "api-spec",
      "need": "API behavior: positive contract tests and negative tests",
      "template": ".qa/templates/specs/api.spec.template.ts",
      "canonical": "tests/api/create-task.spec.ts",
      "output": "tests/api/create-__domain__.spec.ts",
      "rules": "docs/TESTING_STANDARDS.md#api-test-standard"
    },
    {
      "id": "api-scenario-spec",
      "need": "API behavior with table-driven boundary, validation and authorization scenarios",
      "template": ".qa/templates/specs/api-scenarios.spec.template.ts",
      "canonical": "tests/api/update-task.spec.ts",
      "output": "tests/api/update-__domain__.spec.ts",
      "rules": "docs/TESTING_STANDARDS.md#negative-api-test-standard"
    },
    {
      "id": "ui-spec",
      "need": "Browser behavior with API setup, Page Object interaction and a mocked error state",
      "template": ".qa/templates/specs/ui.spec.template.ts",
      "canonical": "tests/ui/task-dashboard.spec.ts",
      "output": "tests/ui/__domain__-__page__.spec.ts",
      "rules": "docs/TESTING_STANDARDS.md#ui-spec-standard"
    },
    {
      "id": "database-spec",
      "need": "Persistence validation after behavior created through the API",
      "template": ".qa/templates/specs/database.spec.template.ts",
      "canonical": "tests/database/task-database.spec.ts",
      "output": "tests/database/__domain__-database.spec.ts",
      "rules": "docs/TESTING_STANDARDS.md#database-test-standard"
    },
    {
      "id": "accessibility-spec",
      "need": "Full-page automated accessibility scans of public and authenticated pages",
      "template": ".qa/templates/specs/accessibility.spec.template.ts",
      "canonical": "tests/accessibility/accessibility.spec.ts",
      "output": "tests/accessibility/accessibility.spec.ts",
      "rules": "docs/TESTING_STANDARDS.md#accessibility-test-standard"
    },
    {
      "id": "visual-spec",
      "need": "Page-level and component-level screenshot contracts on deterministic state",
      "template": ".qa/templates/specs/visual.spec.template.ts",
      "canonical": "tests/visual/visual.spec.ts",
      "output": "tests/visual/visual.spec.ts",
      "rules": "docs/TESTING_STANDARDS.md#visual-regression-test-standard"
    },
    {
      "id": "lighthouse-spec",
      "need": "Authenticated browser performance measured by Lighthouse after deterministic setup",
      "template": ".qa/templates/specs/lighthouse.spec.template.ts",
      "canonical": "tests/performance/lighthouse-dashboard.spec.ts",
      "output": "tests/performance/lighthouse-__page__.spec.ts",
      "rules": "docs/TESTING_STANDARDS.md#browser-performance-standard"
    },
    {
      "id": "k6-workload",
      "need": "API workload performance with setup outside the measured operation and native thresholds",
      "template": ".qa/templates/performance/k6-workload.template.js",
      "canonical": "performance/k6/taskReadLoad.js",
      "output": "performance/k6/__domain__ReadLoad.js",
      "rules": "docs/TESTING_STANDARDS.md#api-performance-standard"
    }
  ]
}
