{
  "$comment": "Paths npm run setup removes from a new project. 'paths' belong to the UPEX reference implementation that lives in this repository (ADR-007); 'templateOnly' validate the template itself. Starter files from .qa/starter are installed in their place.",
  "paths": [
    "src/app",
    "tests/api",
    "tests/ui",
    "tests/smoke",
    "tests/database",
    "tests/accessibility",
    "tests/visual",
    "tests/performance",
    "performance/k6/taskReadLoad.js",
    "Dockerfile.upex-local",
    "docker-compose.local.yml",
    ".qa/roundtrip",
    "docs/adr/ADR-001-target-application.md",
    "docs/adr/ADR-002-realworld-implementation.md",
    "docs/adr/ADR-004-target-application-upex-dojo.md",
    "docs/portfolio",
    ".github/workflows/playwright.yml",
    ".github/workflows/performance.yml",
    ".github/workflows/ghcr-cleanup.yml",
    "docker-compose.yml"
  ],
  "templateOnly": [".qa/selftest", ".qa/scripts/selftest.ts"],
  "scripts": ["db:test:reset", "qa:selftest"]
}
